{
  "name": "靈感收集器",
  "short_name": "靈感",
  "description": "把靈感網址、分類、標籤與縮圖同步到 Google Sheet 的個人收藏工具。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0D0C0B",
